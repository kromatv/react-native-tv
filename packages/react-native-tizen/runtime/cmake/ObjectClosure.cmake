# CMake links an OBJECT library's objects only into a target that names it
# directly, and ReactCommon is mostly OBJECT libraries depending on each other.
# Android lists every $<TARGET_OBJECTS:...> by hand; this walks the graph instead.

function(_rn_tizen_collect_objects target out_var)
  set(_collected ${${out_var}})
  if(NOT TARGET ${target} OR ${target} IN_LIST _collected)
    return()
  endif()
  get_target_property(_aliased ${target} ALIASED_TARGET)
  if(_aliased)
    _rn_tizen_collect_objects(${_aliased} _collected)
    set(${out_var} ${_collected} PARENT_SCOPE)
    return()
  endif()
  list(APPEND _collected ${target})
  get_target_property(_type ${target} TYPE)
  set(_links "")
  if(NOT _type STREQUAL "INTERFACE_LIBRARY")
    get_target_property(_direct ${target} LINK_LIBRARIES)
    if(_direct)
      list(APPEND _links ${_direct})
    endif()
  endif()
  get_target_property(_interface ${target} INTERFACE_LINK_LIBRARIES)
  if(_interface)
    list(APPEND _links ${_interface})
  endif()
  foreach(_link IN LISTS _links)
    if(_link MATCHES "^\\$<" OR NOT TARGET ${_link})
      continue()
    endif()
    _rn_tizen_collect_objects(${_link} _collected)
  endforeach()
  set(${out_var} ${_collected} PARENT_SCOPE)
endfunction()

# Adds to `target` the objects of every OBJECT library reachable from `roots`.
function(rn_tizen_link_object_closure target)
  set(_visited "")
  foreach(_root IN LISTS ARGN)
    _rn_tizen_collect_objects(${_root} _visited)
  endforeach()
  foreach(_candidate IN LISTS _visited)
    get_target_property(_type ${_candidate} TYPE)
    if(_type STREQUAL "OBJECT_LIBRARY")
      target_sources(${target} PRIVATE $<TARGET_OBJECTS:${_candidate}>)
    endif()
  endforeach()
endfunction()
