{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "rewriteRelativeImportExtensions": true
  },
  "exclude": ["src/api", "src/**/*.test.ts", "src/**/*.fixtures.ts"],
  "include": ["src"]
}
