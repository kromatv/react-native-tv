# GN, which generates Skia's Ninja files: the one installed, else the build
# Skia's own bin/fetch-gn downloads, pinned by revision and checked by its
# SHA-256 (docs/reference/skia-rendering.md, section 2). Sets RN_WEBOS_GN.

find_program(RN_WEBOS_GN gn)
if(RN_WEBOS_GN)
  return()
endif()

set(_gn_pin_file "${CMAKE_CURRENT_LIST_DIR}/../skia/gn.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_gn_pin_file}")
file(READ "${_gn_pin_file}" _gn_pin)
string(JSON _gn_revision GET "${_gn_pin}" revision)
string(JSON _gn_url GET "${_gn_pin}" url)

if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
  set(_gn_os mac)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  set(_gn_os linux)
else()
  message(FATAL_ERROR "No pinned gn for ${CMAKE_HOST_SYSTEM_NAME}: install gn and put it on PATH.")
endif()
if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
  set(_gn_platform ${_gn_os}-arm64)
else()
  set(_gn_platform ${_gn_os}-amd64)
endif()
string(JSON _gn_sha256 GET "${_gn_pin}" sha256 ${_gn_platform})
string(REPLACE "<platform>" "${_gn_platform}" _gn_url "${_gn_url}")
string(REPLACE "<revision>" "${_gn_revision}" _gn_url "${_gn_url}")

set(_gn_dir "${RN_WEBOS_CACHE_DIR}/gn/${_gn_revision}-${_gn_platform}")
if(NOT EXISTS "${_gn_dir}/gn")
  set(_gn_archive "${RN_WEBOS_DOWNLOAD_DIR}/gn/gn-${_gn_revision}-${_gn_platform}.zip")
  if(NOT EXISTS "${_gn_archive}")
    message(STATUS "Downloading gn for ${_gn_platform}")
    file(DOWNLOAD "${_gn_url}" "${_gn_archive}.part" EXPECTED_HASH SHA256=${_gn_sha256} STATUS _gn_status)
    list(GET _gn_status 0 _gn_code)
    if(NOT _gn_code EQUAL 0)
      message(FATAL_ERROR "Cannot download ${_gn_url}: ${_gn_status}")
    endif()
    file(RENAME "${_gn_archive}.part" "${_gn_archive}")
  endif()
  file(REMOVE_RECURSE "${_gn_dir}.part")
  file(ARCHIVE_EXTRACT INPUT "${_gn_archive}" DESTINATION "${_gn_dir}.part" PATTERNS gn)
  file(RENAME "${_gn_dir}.part" "${_gn_dir}")
endif()
set(RN_WEBOS_GN "${_gn_dir}/gn")
